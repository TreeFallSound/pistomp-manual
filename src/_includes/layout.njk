<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — pi-Stomp Manual</title>
  {%- if redirect %}
  <meta http-equiv="refresh" content="0; url={{ redirect | url }}">
  <link rel="canonical" href="{{ redirect | url }}">
  {%- endif %}
  <script>
    // Applied before first paint so an explicitly chosen theme never flashes
    // the wrong colours. Kept inline and tiny for that reason.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="{{ '/assets/images/favicon.ico' | url }}" sizes="any">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ 'assets/css/style.css' | fileHash }}">
  {%- if extraCss %}
  {%- for sheet in (extraCss if extraCss is iterable and extraCss is not string else [extraCss]) %}
  <link rel="stylesheet" href="{{ ('/assets/css/' + sheet) | url }}?v={{ ('assets/css/' + sheet) | fileHash }}">
  {%- endfor %}
  {%- endif %}
</head>
<body>
  {%- set navTree = collections.all | eleventyNavigation %}
  {%- set pager = navTree | navPager(page.url) %}
  {%- macro themeToggle(labelled) %}
  <button type="button" class="theme-toggle{% if labelled %} theme-toggle-labelled{% endif %}" aria-label="Colour theme: follow system">
    <span class="theme-icon theme-icon-system" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>
      {%- if labelled %}<span class="theme-name">System</span>{% endif %}
    </span>
    <span class="theme-icon theme-icon-light" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      {%- if labelled %}<span class="theme-name">Light</span>{% endif %}
    </span>
    <span class="theme-icon theme-icon-dark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
      {%- if labelled %}<span class="theme-name">Dark</span>{% endif %}
    </span>
  </button>
  {%- endmacro %}
  <a class="skip-link" href="#content" data-pagefind-ignore>Skip to content</a>
  <header class="topbar" data-pagefind-ignore>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <a href="{{ '/' | url }}" class="topbar-title">pi-Stomp Manual</a>
    {%- if pager.section %}
    <span class="topbar-crumb">{{ pager.section }}</span>
    {%- endif %}
    {{ themeToggle() }}
  </header>
  <div class="scrim" id="scrim" hidden></div>
  <div class="layout">
    <nav class="sidebar" id="sidebar" aria-label="Manual navigation" data-pagefind-ignore>
      <div class="sidebar-header">
        <a href="{{ '/' | url }}" class="sidebar-logo"><img src="{{ '/assets/images/treefallsound-logo.png' | url }}" alt="Tree Fall Sound"></a>
        <a href="{{ '/' | url }}" class="sidebar-title">pi-Stomp Manual</a>
        {{ themeToggle(true) }}
      </div>
      <button type="button" class="search-open" id="search-open" aria-label="Search the manual">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/></svg>
        <span>Search</span>
        <kbd>/</kbd>
      </button>
      {%- macro navList(entries, depth) %}
      <ul class="nav-{% if depth == 0 %}list{% else %}pages nav-depth-{{ depth }}{% endif %}">
        {%- for entry in entries %}
        <li{% if depth == 0 %} class="nav-section"{% endif %}>
          <a href="{{ entry.url | url }}" class="{% if depth == 0 %}nav-section-title{% else %}nav-link{% endif %}{% if page.url == entry.url %} active{% endif %}">{{ entry.title }}</a>
          {%- if entry.children.length %}
          {{ navList(entry.children, depth + 1) }}
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
      {%- endmacro %}
      {{ navList(navTree, 0) }}
    </nav>
    {#- No data-pagefind-body means the page is skipped: redirect stubs and 404
        have no content worth landing on. -#}
    <main class="content{% if wide %} content-wide{% endif %}" id="content"{% if not redirect and page.url != '/404.html' %} data-pagefind-body{% endif %} data-pagefind-meta="section:{{ pager.section or 'Manual' }}" data-source-path="{{ page.inputPath }}" data-line-offset="{{ page.inputPath | frontMatterLineCount }}" data-repo-root="{{ repoRoot }}">
      {{ content | safe }}
      {%- if pager.prev or pager.next %}
      <nav class="pager" aria-label="Manual pages" data-pagefind-ignore>
        {%- if pager.prev %}
        <a class="pager-link pager-prev" href="{{ pager.prev.url | url }}" rel="prev">
          <span class="pager-dir">← Previous</span>
          <span class="pager-title">{{ pager.prev.title }}</span>
        </a>
        {%- endif %}
        {%- if pager.next %}
        <a class="pager-link pager-next" href="{{ pager.next.url | url }}" rel="next">
          <span class="pager-dir">Next →</span>
          <span class="pager-title">{{ pager.next.title }}</span>
        </a>
        {%- endif %}
      </nav>
      {%- endif %}
    </main>
  </div>
  {#- Inert until search.js loads the component bundle on first open; custom
      elements upgrade this markup in place once defined. base-url re-applies
      pathPrefix, which Pagefind's _site-derived result URLs lack. -#}
  <pagefind-config
    bundle-path="{{ '/pagefind/' | url }}"
    base-url="{{ '/' | url }}"
    highlight-param="highlight"
    excerpt-length="22"></pagefind-config>
  <pagefind-modal id="search-modal" reset-on-close data-pagefind-ignore>
    <pagefind-modal-header>
      <pagefind-input placeholder="Search the manual" autofocus></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary></pagefind-summary>
      <pagefind-results max-sub-results="3">
        {#- Pagefind's own template syntax also uses {{ }}, so keep Nunjucks out.
            Classes we style carry an ms- prefix: Pagefind resets every pf-*
            class with `all: revert` at a specificity author rules can't reach.

            One row per matching heading, each showing that section's own
            excerpt and linking to its anchor, so the text a reader picks is the
            text they land on. sub_results is empty when the only match sits
            above the first heading, and only then is the page-wide excerpt
            worth showing. -#}
        {% raw %}
        <script type="text/pagefind-template">
          <li class="pf-result">
            <div class="ms-card">
              <p class="ms-result-title">
                {{#if meta.section}}<span class="ms-result-section">{{ meta.section }}</span><span class="ms-result-sep" aria-hidden="true">»</span>{{/if}}
                <a class="ms-result-link" href="{{ url | safeUrl }}">{{ meta.title | default("Untitled") }}</a>
              </p>
              {{#if sub_results}}
              <ul class="ms-hits">
                {{#each sub_results as sub}}
                <li class="ms-hit">
                  <a class="ms-hit-link" href="{{ sub.url | safeUrl }}">
                    <span class="ms-hit-heading">{{ sub.title | default("Section") }}</span>
                    {{#if sub.excerpt}}<span class="ms-hit-excerpt">{{+ sub.excerpt +}}</span>{{/if}}
                  </a>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if and(not(sub_results), excerpt)}}
              <p class="ms-result-excerpt">{{+ excerpt +}}</p>
              {{/if}}
            </div>
          </li>
        </script>
        {% endraw %}
      </pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
  <script src="{{ '/assets/js/search.js' | url }}?v={{ 'assets/js/search.js' | fileHash }}" defer></script>
  <script src="{{ '/assets/js/highlight.js' | url }}?v={{ 'assets/js/highlight.js' | fileHash }}" defer></script>
  <script src="{{ '/assets/js/ui.js' | url }}?v={{ 'assets/js/ui.js' | fileHash }}"></script>
  <script src="{{ '/assets/js/suggest-edit.js' | url }}?v={{ 'assets/js/suggest-edit.js' | fileHash }}" defer></script>
</body>
</html>
